# Copy to .env.local and fill in. Never commit .env.local.
#
# Which provider answers first. The other becomes the automatic fallback.
#   gemini   -> Gemini primary, DeepSeek fallback
#   deepseek -> DeepSeek primary, Gemini fallback   <- use while Gemini's free quota is spent
MODEL_PROVIDER=deepseek

# Google Gemini (free tier: aistudio.google.com/apikey)
GEMINI_API_KEY=
MODEL=gemini-3.6-flash

# DeepSeek (platform.deepseek.com -> API keys) — OpenAI-compatible.
# Available models (verified 2026-10-04 via GET /models): deepseek-flash, deepseek-v4-pro.
# deepseek-chat does NOT exist.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# low | high | max  (default high). 'low' minimises reasoning tokens; 'off' omits the field.
DEEPSEEK_EFFORT=low
# DEEPSEEK_BASE_URL=https://api.deepseek.com
